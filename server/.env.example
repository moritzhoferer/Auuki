# Copy to server/.env and fill in. server/.env is gitignored, never commit it.

# Intervals.icu: Settings -> Developer Settings -> API key
INTERVALS_API_KEY=
# your athlete id (e.g. i12345, shown in the same place); 0 = the key's athlete
INTERVALS_ATHLETE_ID=0

# Garmin Connect (unofficial API via the garminconnect package).
# Only needed for the first login: run `python -m app.garmin_login` once,
# afterwards the saved tokens are used and the password can be removed again.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# where the tokens are kept (the compose volume mounts /data)
# GARMIN_TOKENSTORE=~/.garminconnect

# folder with the built PWA (npm run build); defaults to ../dist
# STATIC_DIR=
