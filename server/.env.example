# Copy to server/.env if you need to change a default. server/.env is gitignored.
# Riders connect Intervals.icu and Garmin in the app; their keys and tokens are
# kept in DATA_DIR (0600 files), never in this file.

# where riders, Garmin tokens and rides are stored (the container uses /data)
# DATA_DIR=./data

# set to true when the app is served over https (session cookie https only)
# COOKIE_SECURE=false

# folder with the built PWA (npm run build); defaults to ../dist
# STATIC_DIR=
