# Copy to .env next to compose.yaml (gitignored) to serve the app over https on
# the home network with Caddy and a free DuckDNS name. See docs/self-hosting.md.

# start the Caddy service too (leave out for localhost-only use)
COMPOSE_PROFILES=https

# your DuckDNS name; point it (or a local DNS record) at the server's LAN IP
AUUKI_HOST=your-subdomain.duckdns.org

# token from the top of https://www.duckdns.org after login. Keep it secret.
DUCKDNS_API_TOKEN=

# host port for https. Use another one (e.g. 8443) if 443 is taken;
# then the address is https://your-subdomain.duckdns.org:8443
# HTTPS_PORT=443
